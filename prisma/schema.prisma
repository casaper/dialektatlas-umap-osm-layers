datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AgeGroup {
  jung
  alt
  sds
  older
}

model Word {
  id      Int    @id @default(autoincrement())
  wordKey String @unique
  word    String

  // Source CSV references (from word-csv-map)
  csvJung  String?
  csvAlt   String?
  csvSds   String?
  csvOlder String?

  // PDF outline match (from pdf-extract phases 1+2)
  pdfLabel     String?
  pdfStartPage Int?
  sdsPage      Int?
  altJungPage  Int?

  // PDF scan results (from scan-pdf-pages)
  textLabel String?
  qrUrl     String?

  // Audio page URL resolved from qrUrl redirect (multiple Words can share one audio page)
  audioUrl String?

  audioData  WordAudios?     @relation(fields: [audioUrl], references: [audioUrl])
  siteAudios SiteWordAudio[]
  records    SurveyRecord[]
}

model WordAudios {
  audioUrl   String  @id
  title      String?
  pageNumber Int?

  words      Word[]
  siteAudios SiteWordAudio[]
}

model SiteWordAudio {
  id           Int       @id @default(autoincrement())
  audioUrl     String
  wordKey      String?
  chWord       String
  townName     String
  canton       String
  ageGroup     AgeGroup?
  siteCode     String?
  audioFileUrl String?

  wordAudio    WordAudios    @relation(fields: [audioUrl], references: [audioUrl])
  word         Word?         @relation(fields: [wordKey], references: [wordKey])
  surveyRecord SurveyRecord? @relation(fields: [wordKey, ageGroup, siteCode], references: [wordKey, ageGroup, siteCode])

  @@unique([audioUrl, townName, canton, ageGroup])
}

model Site {
  siteCode String  @id
  townName String
  lat      Float?
  lng      Float?
  geometry Json?
  sdsCode  String?
  canton   String?

  records SurveyRecord[]

  @@unique([townName, canton])
}

model SurveyRecord {
  id                Int      @id @default(autoincrement())
  wordKey           String
  ageGroup          AgeGroup
  siteCode          String
  secondarySiteCode String?
  domVar            String
  variants          String[]
  hexcode1          String
  hexcodes          String[]
  nvar              String
  different         Boolean?

  word       Word           @relation(fields: [wordKey], references: [wordKey], onDelete: Cascade)
  site       Site           @relation(fields: [siteCode], references: [siteCode])
  siteAudios SiteWordAudio[]

  @@unique([wordKey, ageGroup, siteCode])
  @@index([wordKey])
  @@index([siteCode])
  @@index([ageGroup])
}
