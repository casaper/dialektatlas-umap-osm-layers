{
  "name": "dialektatlas-umap-osm-layers",
  "version": "1.0.0",
  "description": "Generate uMap (OpenStreetMap) configurations with layers showing the regional distribution of Swiss German words based on Dialektatlas data.",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:backup": "pg_dump dialektatlas-umap | gzip > prisma/db_backups/$(date +%Y-%m-%dT%H_%M_%S).sql.gz",
    "word-map": "tsx --env-file=.env.local src/util.ts word-csv-map",
    "transform-csvs": "tsx --env-file=.env.local src/util.ts transform-csvs",
    "pdf-extract": "tsx --env-file=.env.local src/util.ts pdf-extract",
    "scan-pdf-pages": "tsx --env-file=.env.local src/util.ts scan-pdf-pages",
    "import-regions": "tsx --env-file=.env.local src/util.ts import-regions",
    "resolve-audio-urls": "tsx --env-file=.env.local src/util.ts resolve-audio-urls",
    "crawl-audio": "tsx --env-file=.env.local src/util.ts crawl-audio",
    "ingest-audio-api": "tsx --env-file=.env.local src/util.ts ingest-audio-api",
    "backfill-site-codes": "tsx --env-file=.env.local src/util.ts backfill-site-codes",
    "pipeline": "run-s word-map transform-csvs pdf-extract scan-pdf-pages import-regions resolve-audio-urls crawl-audio ingest-audio-api backfill-site-codes"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "cspell": "^10.0.1",
    "cspell-cli": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "geojson-schema": "^1.0.5",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-sh": "^0.19.0",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/cli-color": "^2.0.6",
    "cli-color": "^2.0.4",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "lodash": "^4.18.1",
    "pg": "^8.22.0",
    "quicktype": "^24.0.2",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=25 <26"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/casaper/dialektatlas-umap-osm-layers.git"
  },
  "author": "Kaspar V. <me@casaper.dev>",
  "homepage": "https://github.com/casaper/dialektatlas-umap-osm-layers?tab=readme-ov-file#readme",
  "keywords": [
    "umap",
    "osm",
    "layers",
    "linguistics",
    "dialects",
    "switzerland",
    "swiss german"
  ],
  "license": "AGPL-3.0-only"
}
